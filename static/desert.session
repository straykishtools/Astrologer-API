<?xml version="1.0" encoding="UTF-8"?>

<session version="2">
<head>
	<name>Desert</name>
	<description>A Desert practice has the specific focus to unwind the mind, unravel the body, and more importantly to open the heart.  The path to freedom in the Desert practice is through flexibility and detoxification.  As the body opens and the flexibility improves, blocked pranic energy ignites the detoxification and the healing processes.&#10;&#10;"In the Desert you have the space to unwind, unravel, spill out on the Desert floor and heal."</description>

	<pose name="Triangle Forward" side="left"/>
	
	<style>yin</style>
	
	<durations>
		<duration value="30"/>
		<duration value="45"/>
		<duration value="60"/>
	</durations>
	
	<difficulties>
		<difficulty value="0"/>
		<difficulty value="1"/>
		<difficulty value="2"/>
	</difficulties>
</head>

<body preferredBackgroundName="Home">

	<!-- ************************************************************************************************** -->
	<!-- Warm Up -->
	<tempo duration="4.0f"/>
	<music type="builtin" id="0"/>
	
	<move name="childwidestart_to_childwidestart"/>
	<hold count="1" phrase="none" audibleCount="false"/>
	
	<!-- Child -->
	<move name="childwidestart_to_childwide"/>
	<hold count="8" phrase="none" audibleCount="false"/>
	
	<move name="childwide_to_childwidesidelean"/>
	<hold count="2" phrase="soften" audibleCount="false"/>
	<move name="childwidesidelean_to_childwide"/>
	<switchside/>
	<move name="childwide_to_childwidesidelean"/>
	<hold count="2" phrase="soften" audibleCount="false"/>
	<move name="childwidesidelean_to_childwide"/>
	<switchside/>

	<loop count="2,4,4" switchside="true">
		<move name="childwide_to_childwidesidelean"/>
		<move name="childwidesidelean_to_childwide"/>
	</loop>
		
	<hold count="2" phrase="soften" audibleCount="false"/>
	<move name="childwide_to_boxneutral"/>
	<hold count="2" phrase="none" audibleCount="false"/>

	<!-- Cat & Dog -->
	<move name="boxneutral_to_dog"/>
	<hold count="2" audibleCount="false"/>
	<move name="dog_to_cat"/>
	
	<loop count="0,1,2">
		<hold count="2" audibleCount="false"/>
		<move name="cat_to_dog"/>
		<hold count="2" audibleCount="false"/>
		<move name="dog_to_cat"/>
	</loop>
	
	<hold count="2" audibleCount="false"/>
	<move name="cat_to_boxneutral"/>
	
	
	<move name="boxneutral_to_downwarddog"/>
	<hold count="4" phrase="none" audibleCount="false"/>
	
	
	<!-- Walk the Dog -->
	<move name="downwarddog_to_downwarddogontoes"/>	
	<hold count="2" audibleCount="false"/>
	
	<loop count="2" switchside="true">
		<move name="downwarddogontoes_to_downwarddoghamstring"/>	
		<hold count="3" phrase="soften" audibleCount="false"/>
		<move name="downwarddoghamstring_to_downwarddogontoes"/>	
	</loop>
		
	<loop count="0,2,4" switchside="true">
		<move name="downwarddogontoes_to_downwarddoghamstring"/>	
		<move name="downwarddoghamstring_to_downwarddogontoes"/>	
	</loop>
			
	<hold count="2" audibleCount="false"/>

	<move name="downwarddogontoes_to_downwarddog"/>
	<hold count="2" phrase="none" audibleCount="false"/>
	

	
	<switchside force="right"/>
	
	<!-- Hand To Ankle Stretch -->
	<difficulty>
		<intermediate>	
			<!-- 14 -->
			<hold count="1" phrase="none" audibleCount="false"/>
			<loop count="2" switchside="true">
				<move name="downwarddog_to_downwarddoghandtoankle"/>
				<hold count="4" audibleCount="false"/>
				<move name="downwarddoghandtoankle_to_downwarddog"/>
			</loop>
			<hold count="1" phrase="none" audibleCount="false"/>
		</intermediate>
		<beginner>
			<!-- 15 -->
			<move name="downwarddog_to_boxneutral"/>
			<loop count="2" switchside="true">
				<move name="boxneutral_to_boxhandtoankle"/>
				<hold count="4" phrase="soften" audibleCount="false"/>
				<move name="boxhandtoankle_to_boxneutral"/>
			</loop>
			<move name="boxneutral_to_downwarddog"/>
			<hold count="1" phrase="none" audibleCount="false"/>
		</beginner>
	</difficulty>
		
	
	

	<!-- ************************************************************************************************** -->
	<!-- Flow -->
	<music type="builtin" id="1"/>

	
	<!-- Sun Salutation A -->
	<loop count="2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="downwarddogbentknees_to_lungekneeling"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="warriorIkneeling_to_forwardbend"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountainarmsup_to_mountain"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountain_to_mountainarmsup"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
				<hold count="2" phrase="none" audibleCount="false"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbend_to_mountainarmsup"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountainarmsup_to_mountain"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountain_to_mountainarmsup"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="mountainarmsup_to_forwardbend"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
				<hold count="2" phrase="none" audibleCount="false"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_lungekneeling"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="warriorIkneeling_to_fourlimbedstaff"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="upwarddog_to_downwarddog"/>
		<hold count="2" phrase="none" audibleCount="false"/>
	</loop>
	
	
	<!-- Sun Salutation A -->
	<loop count="2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_forwardbend"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_fourlimbedstaff"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>	
	
	
	<!-- Sun Salutation A (silent) -->
	<dynamicstate state="silent"/>
	
	<loop count="0,4,4" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_forwardbend"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_fourlimbedstaff"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>	
	
	<dynamicstate state="normal"/>
	

	<!-- Sun Salutation B -->
	<loop count="0,0,4" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>
	
	
	<!-- Sun Salutation B (silent) -->
	<dynamicstate state="silent"/>
	
	<loop count="0,0,4" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>
	
	<dynamicstate state="normal"/>

	

	<loop count="0,1,1">

		<!-- Chair Twist (both sides) -->
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-float"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		<move name="forwardbendhalfway_to_forwardbenddeep"/>
		<move name="forwardbenddeep_to_chair"/>
		<hold count="1" phrase="hold" audibleCount="false"/>
		<move name="chair_to_chairprayer"/>
		<hold count="1" phrase="none" audibleCount="false"/>
		
		<switchside force="right"/>	
			
		<loop count="2" switchside="true">
			<move name="chairprayer_to_chairtwist"/>	
			<hold count="1" phrase="none" audibleCount="false"/>
			
			<move name="chairtwist_to_chairtwistextended"/>
			<hold count="4" phrase="hold" audibleCount="false"/>

			<move name="chairtwistextended_to_chairtwist"/>
			<move name="chairtwist_to_chairprayer"/>
			<hold count="1" phrase="none" audibleCount="false"/>
		</loop>
		
		<move name="chairprayer_to_chair"/>
		<move name="chair_to_forwardbenddeep"/>
		
		<loop count="0,1,0">

			<!-- Come out of chair twist -->
			<move name="forwardbenddeep_to_forwardbendhalfway"/>
			
			<difficulty>
				<expert>
					<move name="forwardbendhalfway_to_fourlimbedstaff-float"/>
				</expert>
				<beginner>
					<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
				</beginner>
			</difficulty>
			
			<move name="fourlimbedstaff_to_upwarddog"/>
			
		</loop>
		
		
		<loop count="0,0,1">

			<tempo duration="3.5f"/>
			
			<move name="forwardbenddeep_to_forwardbendhalfway"/>

			<!-- Plank -->
			<difficulty>
				<expert>
					<pose name="Plank" count="-60" phrase="hold" audibleCount="true"/>
				</expert>
				<beginner>
					<pose name="Plank Kneeling" count="-60" phrase="hold" audibleCount="true"/>
				</beginner>
			</difficulty>
			<pose name="Four Limbed Staff"/>
			<pose name="Upward Dog"/>
			
		</loop>
		
		
		<difficulty>
			<expert>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</expert>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>		
				
	</loop>
	
	
	<tempo duration="3.5f"/>

		
	<!-- Rest 1 -->
	<move name="downwarddog_to_boxneutral"/>
	<move name="boxneutral_to_childwide"/>
	<hold count="variable" phrase="rest" audibleCount="false"/>
	<move name="childwide_to_boxneutral"/>
	<move name="boxneutral_to_downwarddog"/>

	

		
	
	<loop count="2" switchside="true">

		<!-- Wheel -->
		<move name="downwarddog_to_downwarddoglegup"/>
		
		<difficulty>
			<expert>
				<!-- 16 -->
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="downwarddoglegup_to_downwarddoglegupstackhips"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="downwarddoglegupstackhips_to_wheelflip"/>
				<hold count="3" phrase="hold" audibleCount="false"/>
				
				<move name="wheelflip_to_wheelfliplegup"/>
				<hold count="3"/>
				<move name="wheelfliplegup_to_wheelflip"/>

				<move name="wheelflip_to_downwarddoglegup"/>
				<hold count="1" phrase="none" audibleCount="false"/>
			</expert>
			<intermediate>
				<!-- 9 -->
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="downwarddoglegup_to_downwarddoglegupstackhips"/>
				<hold count="4"/>
				<move name="downwarddoglegupstackhips_to_downwarddoglegup"/>
				<hold count="1" phrase="none" audibleCount="false"/>
			</intermediate>
			<beginner>
				<!-- 4 -->
				<hold count="4"/>
			</beginner>
		</difficulty>

		<move name="downwarddoglegup_to_downwarddog"/>


		<!-- Desert Push-ups -->
		<move name="downwarddog_to_boxneutral"/>
		<move name="boxneutral_to_child"/>
		
		<loop count="3">		
			<move name="child_to_upwarddog"/>
			<move name="upwarddog_to_child"/>
		</loop>
		
		<dynamicstate state="silent"/>
		<loop count="6">		
			<move name="child_to_upwarddog"/>
			<move name="upwarddog_to_child"/>
		</loop>
		<dynamicstate state="normal"/>		
		<move name="child_to_upwarddog"/>
	
		<move name="upwarddog_to_downwarddog"/>	


		<switchside force="right"/>
		
		<!-- Hand To Ankle Stretch -->
		<difficulty>
			<intermediate>	
				<!-- 14 -->
				<hold count="1" phrase="none" audibleCount="false"/>
				<loop count="2" switchside="true">
					<move name="downwarddog_to_downwarddoghandtoankle"/>
					<hold count="4" audibleCount="false"/>
					<move name="downwarddoghandtoankle_to_downwarddog"/>
				</loop>
				<hold count="1" phrase="none" audibleCount="false"/>
			</intermediate>
			<beginner>
				<!-- 15 -->
				<move name="downwarddog_to_boxneutral"/>
				<loop count="2" switchside="true">
					<move name="boxneutral_to_boxhandtoankle"/>
					<hold count="4" phrase="soften" audibleCount="false"/>
					<move name="boxhandtoankle_to_boxneutral"/>
				</loop>
				<move name="boxneutral_to_downwarddog"/>
				<hold count="1" phrase="none" audibleCount="false"/>
			</beginner>
		</difficulty>
					
	</loop>	
	
	

	<switchside force="right"/>
	
	
	<!-- Warrior -->
	<loop count="2" switchside="true">
	
		<!-- Warrior I -->
		
		<move name="downwarddog_to_downwarddoglegup"/>
		<move name="downwarddoglegup_to_lunge"/>
		<move name="lunge_to_warriorI"/>
		<hold count="3" phrase="hold" audibleCount="false"/>
	
			
		<loop count="1,0,0">
		
			<!-- warrior II -->
			
			<move name="warriorI_to_warriorII"/>
			<hold count="3" phrase="hold" audibleCount="false"/>
			
		</loop>
				
		<loop count="0,1,1">
		
			<!-- Warrior Twist -->
			
			<move name="warriorI_to_warriorprayer"/>
			<move name="warriorprayer_to_warriortwist"/>
			
			<difficulty>
				<intermediate>
					<!-- 6 -->
					<hold count="1" phrase="none" audibleCount="false"/>
					<move name="warriortwist_to_warriortwistextended"/>
					<hold count="3" phrase="hold" audibleCount="false"/>
					<move name="warriortwistextended_to_warriortwist"/>
				</intermediate>
				<beginner>
					<!-- 3 -->
					<hold count="3" phrase="hold" audibleCount="false"/>
				</beginner>
			</difficulty>
			
			<move name="warriortwist_to_warriorprayer"/>
			<move name="warriorprayer_to_warriorII"/>
			
			
			<!-- Triangle -->

		
			<move name="warriorII_to_triangle"/>
			<move name="triangle_to_triangleforward"/>
			<hold count="3" phrase="hold" audibleCount="false"/>
			<move name="triangleforward_to_triangle"/>
			<move name="triangle_to_warriorII"/>
			
		</loop>
		
		
		<move name="warriorII_to_warriorIIforward"/>
		
		
		<!-- Bird of Paradise -->
		
		<difficulty>
			<expert>
				<!-- 12 -->
				<move name="warriorIIforward_to_lungebind"/>
				<move name="lungebind_to_chairtwistbind"/>
				<hold count="1" phrase="none" audibleCount="false"/>
				<move name="chairtwistbind_to_chairtwistbindup"/>
				<hold count="3"/>

				<move name="chairtwistbindup_to_chairtwistbind"/>
				<hold count="1" phrase="none" audibleCount="false"/>
				<move name="chairtwistbind_to_lungebind"/>
				<hold count="1" phrase="none" audibleCount="false"/>
				<move name="lungebind_to_warriorIIforward"/>
			</expert>	
			<intermediate>
				<!-- 5 -->
				<move name="warriorIIforward_to_lungebind"/>
				<hold count="3"/>
				<move name="lungebind_to_warriorIIforward"/>
			</intermediate>
			<beginner>
				<!-- 3 -->
				<hold count="3"/>
			</beginner>
		</difficulty>
		
		<move name="warriorIIforward_to_warriorII"/>
			
		<move name="warriorII_to_fourlimbedstaff"/>
		
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	
	</loop>	
	
	<hold count="2" phrase="soften" audibleCount="false"/>
	

	
	<!-- Rest 2	(for non Experts) -->
	<difficulty>
		<expert>
			<hold count="0" phrase="none" audibleCount="false"/>
		</expert>
		<beginner>
			<move name="downwarddog_to_boxneutral"/>
			<move name="boxneutral_to_childwide"/>
			<hold count="variable" phrase="rest" audibleCount="false"/>
			<move name="childwide_to_boxneutral"/>
			<move name="boxneutral_to_downwarddog"/>
		</beginner>
	</difficulty>
	

			
			
	<!-- Sun Salutation A -->
	<loop count="0,0,2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_forwardbend"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_fourlimbedstaff"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
		
	</loop>	


	<!-- Sun Salutation A (silent) -->
	<dynamicstate state="silent"/>
		
	<loop count="0,0,2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_forwardbend"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_mountainarmsup"/>
				<move name="mountainarmsup_to_mountain"/>
				<move name="mountain_to_mountainarmsup"/>
				<move name="mountainarmsup_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_lungekneeling"/>
		<move name="lungekneeling_to_warriorIkneeling"/>
		<move name="warriorIkneeling_to_fourlimbedstaff"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
		
	</loop>	

	<dynamicstate state="normal"/>			


	<!-- Sun Salutation B Advanced -->
	<loop count="0,0,2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		
		<difficulty>
			<expert>
				<move name="downwarddogbentknees_to_forwardbend-float"/>
			</expert>
			<beginner>
				<move name="downwarddogbentknees_to_forwardbend-step"/>
			</beginner>
		</difficulty>
				
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
				
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_fourlimbedstaff-float"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
			</beginner>
		</difficulty>
		
		<move name="fourlimbedstaff_to_upwarddog"/>
		
		<difficulty>
			<expert>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</expert>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>
		
	</loop>
	

	<!-- Sun Salutation B Advanced (silent) -->
	<dynamicstate state="silent"/>
	
	<loop count="0,0,2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		
		<difficulty>
			<expert>
				<move name="downwarddogbentknees_to_forwardbend-float"/>
			</expert>
			<beginner>
				<move name="downwarddogbentknees_to_forwardbend-step"/>
			</beginner>
		</difficulty>
				
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
				
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_fourlimbedstaff-float"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
			</beginner>
		</difficulty>
		
		<move name="fourlimbedstaff_to_upwarddog"/>
		
		<difficulty>
			<expert>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</expert>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>
		
	</loop>
	
	
	<dynamicstate state="normal"/>		
	



	<loop count="0,1,1">

		<!-- Plank -->
		<difficulty>
			<expert>
				<pose name="Plank" count="-60" phrase="hold" audibleCount="true"/>
			</expert>
			<beginner>
				<pose name="Plank Kneeling" count="-60" phrase="hold" audibleCount="true"/>
			</beginner>
		</difficulty>
		<pose name="Four Limbed Staff"/>
		<pose name="Upward Dog"/>
		
		<difficulty>
			<intermediate>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</intermediate>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>		
	
	</loop>
	
							
	
	<!-- Tree -->
	
	<loop count="0,1,1">
	
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_mountainarmsup"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_mountainarmsup"/>
			</beginner>
		</difficulty>	
		
		<move name="mountainarmsup_to_mountain"/>
		
		<loop count="2" switchside="true">
			<move name="mountain_to_tree"/>
			<hold count="6" phrase="hold" audibleCount="false"/>
			<move name="tree_to_mountain"/>
			<hold count="1" phrase="none" audibleCount="false"/>
		</loop>

		<move name="mountain_to_mountainarmsup"/>

		<difficulty>
			<expert>
				<move name="mountainarmsup_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="mountainarmsup_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
		
	</loop>
	
	<move name="downwarddog_to_boxneutral"/>



	
	<!-- ************************************************************************************************** -->
	<!-- Cool Down -->
	<music type="builtin" id="2"/>


	
	
	<!-- Pigeon & Knee Pile-->
		
				
	<loop count="0,2,2" switchside="true">
		<move name="boxneutral_to_pigeonhalf"/>
		
		
		<!-- Pigeon -->
		
		<difficulty>
			<expert>
				<hold count="2,2,4" phrase="rest" audibleCount="false"/>
				<move name="pigeonhalf_to_pigeonfull"/>
				<hold count="3,3,4" phrase="soften" audibleCount="false"/>
				<move name="pigeonfull_to_kneepile"/>
			</expert>
			<beginner>
				<hold count="5,5,9" phrase="rest" audibleCount="false"/>
				<move name="pigeonhalf_to_kneepile"/>
			</beginner>
		</difficulty>
		
		<!-- Knee Pile -->
		
		<difficulty>
			<intermediate>
				<hold count="1" phrase="none" audibleCount="false"/>
				<move name="kneepile_to_kneepilebind"/>
				<hold count="2" phrase="hold" audibleCount="false"/>
				<move name="kneepilebind_to_kneepile"/>
			</intermediate>
			<beginner>
				<hold count="5" phrase="none" audibleCount="false"/>
			</beginner>
		</difficulty>	
		
		<move name="kneepile_to_boxneutral"/>
	</loop>
	
	
	
	<!-- Seated Forward bend -->
	<move name="boxneutral_to_seatedforwardbendpreparation"/>	
	<hold count="1" phrase="none" audibleCount="false"/>
	
	<move name="seatedforwardbendpreparation_to_seatedforwardbend"/>	
	<hold count="4,6,8" phrase="soften" audibleCount="false"/>
	<move name="seatedforwardbend_to_corpse"/>
	<hold count="1" phrase="none" audibleCount="false"/>
		
	
		
	<!-- Wheel -->
	<difficulty>
		<expert>
			<pose name="Wheel" count="-60" phrase="hold" audibleCount="true"/>
		</expert>
		<intermediate>
			<pose name="Bridge" count="-30" phrase="hold" audibleCount="true"/>
			<pose name="Wheel" count="-30" phrase="hold" audibleCount="true"/>
		</intermediate>
		<beginner>
			<pose name="Bridge" count="-60" phrase="hold" audibleCount="true"/>
		</beginner>
	</difficulty>
	<pose name="Corpse"/>


	<move name="corpse_to_turtle"/>
	<hold count="3" phrase="none" audibleCount="false"/>
	
	<pose name="Corpse"/>

	<difficulty>
		<expert>
			<pose name="Corpse Double Leg Raise" count="5"/>
			<pose name="Shoulderstand Supported" count="5" phrase="hold" audibleCount="false"/>
			<pose name="Plow" count="5"/>
			<pose name="Deaf Man" count="5"/>
			<pose name="Corpse" count="3"/>
		</expert>
		<intermediate>
			<pose name="Corpse Double Leg Raise" count="6"/>
			<pose name="Shoulderstand Supported" count="6" phrase="hold" audibleCount="false"/>
			<pose name="Plow" count="6"/>
			<pose name="Corpse" count="3"/>
		</intermediate>
		<beginner>
			<pose name="Corpse Double Leg Raise" count="7"/>
			<pose name="Corpse"/>
		</beginner>
	</difficulty>
	
	
	<!-- ************************************************************************************************** -->
	<!-- Savasana -->
	<music type="builtin" id="3"/>
	
	<move name="corpse_to_savasana"/>
	<hold count="50,67,84" phrase="none" audibleCount="false"/>

	
</body>
</session>
