<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.rainfrog.yoga.view.util.BackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.rainfrog.yoga.view.util.BoundedLinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/rect_rounded_dark"
            android:paddingLeft="32dp"
            android:paddingTop="24dp"
            android:paddingRight="32dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:bounded_width="460dp">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/congratulations_"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:id="@+id/congrats_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/you_have_completed_your_practice_"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/calories_burned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/scene_overlay_calorie_icon"
                            android:tint="#fff"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calories_burned"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/karma_points_earned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/karma_symbol_small"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Karma Points Earned"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#fff"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/karma_points_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/karma_symbol_small"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Karma Points"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/post_session_dividing_bar"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/share"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share"/>
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/done"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="@string/done"/>
            </LinearLayout>
        </com.rainfrog.yoga.view.util.BoundedLinearLayout>
    </ScrollView>
</FrameLayout>
