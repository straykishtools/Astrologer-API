<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeight">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:contentDescription="@string/poses"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#fff"
            android:id="@+id/localizedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="@string/pose_awkward"
            android:textIsSelectable="false"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#fff"
            android:id="@+id/sanskritName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="@string/pose_awkward"
            android:layout_below="@+id/localizedName"
            android:layout_alignLeft="@+id/localizedName"
            android:textIsSelectable="false"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:layout_gravity="center_vertical"
        android:id="@+id/category"
        android:visibility="gone"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:text="@string/pose_awkward"
        android:textIsSelectable="false"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff"
        android:layout_gravity="center_vertical"
        android:id="@+id/subcategory"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/pose_awkward"
        android:textIsSelectable="false"/>
</LinearLayout>
