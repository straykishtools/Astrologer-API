<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#fff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/store_background_detail_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/bg_l1_home_tnstore"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/store_background_lock_icon"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/store_background_detail_padding">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#666"
                android:layout_gravity="center"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"/>
            <com.rainfrog.yoga.view.store.StoreButton
                android:layout_gravity="center"
                android:id="@+id/store_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/store_button"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
