<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#cae9fc"
    android:padding="@dimen/history_detail_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:paddingTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:background="#b2d0e9"
            android:padding="1px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="#edf8fd"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:gravity="right"
                        android:paddingRight="10dp"
                        android:layout_width="90sp"
                        android:layout_height="wrap_content"
                        android:text="@string/practice"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:id="@+id/practice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ocean"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:gravity="right"
                        android:paddingRight="10dp"
                        android:layout_width="90sp"
                        android:layout_height="wrap_content"
                        android:text="@string/date"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Aug 9, 2010 11:12 pm"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:gravity="right"
                        android:paddingRight="10dp"
                        android:layout_width="90sp"
                        android:layout_height="wrap_content"
                        android:text="@string/duration"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:id="@+id/duration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="45 minutes"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:gravity="right"
                        android:paddingRight="10dp"
                        android:layout_width="90sp"
                        android:layout_height="wrap_content"
                        android:text="@string/difficulty"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:id="@+id/difficulty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Easy peasy summer squeezy"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
