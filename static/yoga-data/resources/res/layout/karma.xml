<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#cae9fc"
    android:layout_width="320dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#666666"
        android:paddingLeft="14dp"
        android:paddingTop="28dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/total_karma_points"/>
    <FrameLayout
        android:background="#b2d0e9"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#edf8fd"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="60sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:id="@+id/karma_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3sp"
                android:text="100"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3sp"
                android:src="@drawable/karma_symbol"
                android:scaleType="fitStart"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:background="#b2d0e9"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/karma_description"/>
</LinearLayout>
