<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="1px"
                android:color="#000000"/>
            <gradient
                android:startColor="#dcdcdc"
                android:endColor="#333333"
                android:angle="270"/>
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1px"
                android:color="#000000"/>
            <gradient
                android:startColor="#a5a5a5"
                android:endColor="#111111"
                android:angle="270"/>
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
        </shape>
    </item>
</selector>
