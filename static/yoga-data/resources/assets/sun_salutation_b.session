<?xml version="1.0" encoding="UTF-8"?>

<session version="2">
<head>
	<name>Sun Salutation B</name>
	<description>The Gaia Flow Yoga variation of Surya Namaskara Kha, Sun Salutation B, is a series of postures, performed in a rigorous Vinyasa flow with fiery breath-work, that stimulate the metabolism and move stagnant energy.  This fast paced series encourages cardiovascular conditioning, detoxification and stress release.</description>

	<pose name="Chair" side="left"/>
	
	<style>power</style>
	
	<durations type="repetitions">
		<duration value="2"/>
		<duration value="4"/>
		<duration value="6"/>
		<duration value="8"/>
		<duration value="10"/>
		<duration value="20"/>
		<duration value="30"/>
		<duration value="108"/>
	</durations>
	
	<difficulties>
		<difficulty value="0"/>
		<difficulty value="1"/>
		<difficulty value="2"/>
	</difficulties>
</head>

<body preferredBackgroundName="Home">

	<!-- ************************************************************************************************** -->
	<!-- Warm Up -->
	<tempo duration="4.0f"/>
	<music type="builtin" id="0"/>
	
	<move name="downwarddogstart_to_downwarddogstart"/>
	<hold count="1" phrase="none" audibleCount="false"/>

	<move name="downwarddogstart_to_downwarddog"/>
	<hold count="2" phrase="none" audibleCount="false"/>
	
	<!-- Sun Salutation B -->
	<loop count="2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbenddeep_to_chair"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="chair_to_forwardbenddeep"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
				<hold count="2" phrase="none" audibleCount="false"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbend_to_chair"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="chair_to_forwardbend"/>
				<hold count="2" phrase="none" audibleCount="false"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
				<hold count="2" phrase="none" audibleCount="false"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<hold count="2" phrase="none" audibleCount="false"/>
		<move name="upwarddog_to_downwarddog"/>
		<hold count="2" phrase="none" audibleCount="false"/>
	</loop>
	

	<!-- ************************************************************************************************** -->
	<!-- Flow -->
	<music type="builtin" id="1"/>
	
	
	<tempo duration="6.0f"/>
	
	<!-- Sun Salutation B -->
	<loop count="0,1,1,1,1,1,1,1" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>
	
	
	<tempo duration="5.0f"/>
	
	<!-- Sun Salutation B -->
	<loop count="0,1,1,1,1,1,1,1" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>
		
	
			
	<tempo duration="4.0f"/>
	
	<!-- Sun Salutation B -->
	<loop count="0,0,2,2,2,2,2,2" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		<move name="downwarddogbentknees_to_forwardbend-step"/>
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
		<move name="fourlimbedstaff_to_upwarddog"/>
		<move name="upwarddog_to_downwarddog"/>
	</loop>



		
	<!-- Sun Salutation B Advanced -->
	<loop count="0,0,0,2,4,4,4,4" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		
		<difficulty>
			<expert>
				<move name="downwarddogbentknees_to_forwardbend-float"/>
			</expert>
			<beginner>
				<move name="downwarddogbentknees_to_forwardbend-step"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_fourlimbedstaff-float"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
			</beginner>
		</difficulty>
		
		<move name="fourlimbedstaff_to_upwarddog"/>
		
		<difficulty>
			<expert>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</expert>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>
	</loop>		
	
	
	
	<!-- Sun Salutation B (silent) -->
	<dynamicstate state="silent"/>
	
	<loop count="0,0,0,0,0,10,20,98" switchside="true">
		<move name="downwarddog_to_downwarddogbentknees"/>
		
		<difficulty>
			<expert>
				<move name="downwarddogbentknees_to_forwardbend-float"/>
			</expert>
			<beginner>
				<move name="downwarddogbentknees_to_forwardbend-step"/>
			</beginner>
		</difficulty>
		
		<move name="forwardbend_to_forwardbendhalfway"/>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_chair"/>
				<move name="chair_to_forwardbenddeep"/>
				<move name="forwardbenddeep_to_forwardbendhalfway"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_forwardbend"/>
				<move name="forwardbend_to_chair"/>
				<move name="chair_to_forwardbend"/>
				<move name="forwardbend_to_forwardbendhalfway"/>
			</beginner>
		</difficulty>
		
		<difficulty>
			<expert>
				<move name="forwardbendhalfway_to_fourlimbedstaff-float"/>
			</expert>
			<beginner>
				<move name="forwardbendhalfway_to_fourlimbedstaff-step"/>
			</beginner>
		</difficulty>
		
		<move name="fourlimbedstaff_to_upwarddog"/>
		
		<difficulty>
			<expert>
				<move name="upwarddog_to_downwarddog-pushup"/>
			</expert>
			<beginner>
				<move name="upwarddog_to_downwarddog"/>
			</beginner>
		</difficulty>
		
	</loop>		
	
	<hold count="2" phrase="rest" audibleCount="false"/>
	
</body>
</session>
