# Cosmic Oracle — Environment variables template
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# ─── Runtime environment ───
# One of: dev | test | production
# - dev:        CORS allows "*" for localhost tooling
# - test:       disables guest rate limiting & premium gating (CI/pytest)
# - production: enables SecretKeyCheckerMiddleware and strict CORS
ENV_TYPE=dev

# ─── Security ───
# Secret used to sign JWT auth tokens (generate locally; never commit the generated value)
JWT_SECRET_KEY=

# RapidAPI / private API gateway keys (checked by SecretKeyCheckerMiddleware in production)
RAPID_API_KEY=
RAPID_API_SECRET_KEY=
ASTROLOGER_STUDIO_SECRET_KEY=
PRIVATE_ASTROLOGER_API_SECRET_KEY=

# ─── External services ───
# Keys are read by the server only; never expose them in browser code.
NASA_API_KEY=
GEO_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ─── AI chart interpretation (direct provider, OpenAI-compatible) ───
# When AI_API_BASE is set, it takes priority over the local proxy path.
# Example: AI_API_BASE=https://api.b.ai/v1  AI_MODEL=bai/glm-5.3-flash
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# ─── Ephemeris ───
# Backend used by kerykeion, e.g. libephemeris (no pyswisseph required)
KERYKEION_EPHEMERIS_BACKEND=libephemeris

# ─── Logging ───
LOG_LEVEL=INFO

# ─── Database (SQLAlchemy / Cosmic Oracle) ───
# Leave unset to use the default sqlite file (cosmic_oracle.db)
# COSMIC_DB_URL=sqlite+aiosqlite:///./cosmic_oracle.db
